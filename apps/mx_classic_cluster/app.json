{
  "id": "mx_classic_cluster",
  "title": "ARC Cluster",
  "description": "Custom gauges on the instrument cluster: the Arc style (one tach, big readouts) and the Tech style (two dials)",
  "version": "0.18.0",
  "priority": "PRIO_MEDIUM",
  "backgroundPriority": 150,
  "vendor": "custom",
  "loggingId": "OAC7",
  "iconGlyph": "gauge",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs",
      "operationPaddleSwitch": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature (Arc style)",
      "ExteriorTemperature": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "the intake air temperature (Arc style)",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "the gear readout's S / manual from the gearbox (else the lever and paddles)",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "the gear readout's S gate and manual from the lever",
      "basicDataSet": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "ARC Cluster",
      "buttons": [
        [
          "BTN_TOGGLE",
          "Cluster on / off"
        ],
        [
          "BTN_SWEEP",
          "Needle sweep"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "on",
      "label": "Show on the cluster",
      "type": "bool",
      "default": true
    },
    {
      "key": "arcBg",
      "label": "Background",
      "type": "choice",
      "default": "dusk",
      "options": [
        [
          "dusk",
          "Dusk"
        ],
        [
          "duskTop",
          "Dusk from the top"
        ],
        [
          "grid",
          "Horizon grid"
        ]
      ],
      "aliases": {
        "graphite": "dusk",
        "twin": "dusk"
      },
      "reset": 1
    },
    {
      "key": "boostStyle",
      "label": "Boost readout",
      "type": "choice",
      "default": "number",
      "options": [
        [
          "number",
          "Number"
        ],
        [
          "bar",
          "Number and bar"
        ]
      ]
    },
    {
      "key": "notch",
      "label": "Driver camera above the cluster (tach kept clear of it)",
      "type": "bool",
      "default": true
    },
    {
      "key": "units",
      "label": "Speed",
      "type": "choice",
      "default": "mph",
      "options": [
        [
          "mph",
          "mph (km/h inner scale)"
        ],
        [
          "kmh",
          "km/h (mph inner scale)"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperatures",
      "type": "choice",
      "default": "f",
      "options": [
        [
          "f",
          "Fahrenheit"
        ],
        [
          "c",
          "Celsius"
        ]
      ]
    },
    {
      "key": "redline",
      "label": "Redline",
      "type": "number",
      "unit": "rpm",
      "default": 7000,
      "steps": [
        5000,
        5500,
        6000,
        6500,
        7000,
        7500,
        8000,
        8500
      ]
    },
    {
      "key": "sweep",
      "label": "Needle sweep at start",
      "type": "bool",
      "default": true
    },
    {
      "key": "shift",
      "label": "Shift lights",
      "type": "bool",
      "default": true
    },
    {
      "key": "bottomStrip",
      "label": "Bottom strip (test)",
      "type": "choice",
      "default": "covered",
      "options": [
        [
          "covered",
          "Covered (default)"
        ],
        [
          "letter",
          "Open over BMW's gear letter only (80 x 60, bottom right)"
        ],
        [
          "open",
          "Open: the car's own bar shows"
        ],
        [
          "gear",
          "Open over the car's gear and drive mode only"
        ],
        [
          "nogear",
          "Open except over the gear and drive mode"
        ]
      ]
    },
    {
      "key": "retake",
      "label": "Retry after BMW pop-ups (off: wait until the cluster is free)",
      "type": "bool",
      "default": false
    },
    {
      "key": "demo",
      "label": "Demo data on the cluster",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Never"
        ],
        [
          "on",
          "Always (parked testing only)"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "software",
      "reset": 1,
      "hidden": true,
      "options": [
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "amber",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ],
      "hidden": true
    }
  ],
  "config": {
    "dme": {
      "comment": "intake air temperature from the engine unit (0x12), read-only (UDS 0x22 / OBD 01), the same candidates as M Vitals",
      "ecu": 18,
      "iat": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "charge air cooler temperature, bank 1 sensor 1"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "the same PID with OBD service 01, for engine units that refuse F40F with NRC 31"
        }
      ]
    }
  },
  "credits": false
}
