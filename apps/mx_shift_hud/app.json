{
  "id": "mx_shift_hud",
  "title": "Shift HUD",
  "description": "Shift lights, the gear and boost on the head-up display",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OACA",
  "iconGlyph": "HUD",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusSwitchDriveDynamicSport2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Shift HUD",
      "buttons": [
        ["BTN_TOGGLE", "HUD on / off"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "on", "label": "Show on the HUD", "type": "bool", "default": true},
    {"key": "show", "label": "When", "type": "choice", "default": "always",
     "options": [["always", "Always (while the car sends data)"], ["sport", "Sport modes only"]]},
    {"key": "redline", "label": "Redline (all lights flash from here)", "type": "number", "unit": "rpm", "default": 7000,
     "steps": [5000, 5500, 6000, 6250, 6500, 6750, 7000, 7250, 7500, 8000, 8500]},
    {"key": "span", "label": "Shift lights start below the redline", "type": "number", "unit": "rpm", "default": 2500,
     "steps": [1000, 1500, 2000, 2500, 3000, 3500]},
    {"key": "flash", "label": "Flash at the redline", "type": "bool", "default": true},
    {"key": "boost", "label": "Show boost", "type": "bool", "default": true},
    {"key": "boostRef", "label": "Boost signal", "type": "choice", "default": "gauge",
     "options": [["gauge", "Gauge (0 at idle)"], ["absolute", "Absolute (subtract 14.7 psi)"]]},
    {"key": "demo", "label": "Demo data on the HUD", "type": "choice", "default": "off",
     "options": [["off", "Never"], ["on", "Always (parked testing only)"]]}
  ]
}
